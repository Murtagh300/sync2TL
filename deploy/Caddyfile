# BlackVault behind Caddy: HTTPS (automatic certificates), the security headers a page can't set
# itself, the wallet as static files, and the server on the same origin (no CORS needed).

# www. goes to the domain itself, so the wallet has one origin (its storage and keys live per origin)
www.{$WALLET_DOMAIN} {
	redir https://{$WALLET_DOMAIN}{uri} permanent
}

{$WALLET_DOMAIN} {
	encode zstd gzip

	header {
		# the wallet may never be framed (clickjacking), and only speaks HTTPS
		Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# the server: gateway, push, health, config, error reports
	@server path /api/* /push/* /health /status /config /errors
	handle @server {
		reverse_proxy server:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv/wallet

		# the app shell and the service worker are always checked for a newer version
		@shell path / /index.html /sw.js /push-sw.js /forward.js /manifest.json
		header @shell Cache-Control "no-cache"
		# built assets carry a hash in their name: cache them for a year
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		# addresses can be in paths: no query strings, no client addresses in the log
		format filter {
			wrap console
			fields {
				request>uri query {
					delete *
				}
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}
