# the domain the wallet is served from (DNS must point here; Caddy gets the certificate)
WALLET_DOMAIN=bvwallet.xyz
# more domains for the same wallet (each its own origin: wallets do not carry over between them)
# WALLET_SITES=bvwallet.xyz, wallet.blackvemarket.com
# WALLET_ORIGINS=https://bvwallet.xyz,https://wallet.blackvemarket.com

# push notifications: make a pair once with `npm run vapid` in server/, keep the private key secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@blackvemarket.com

# to read error reports: curl -H "Authorization: Bearer $ADMIN_TOKEN" https://$WALLET_DOMAIN/errors
# (a long random string; leave empty to turn reading off)
ADMIN_TOKEN=

# upstreams (defaults shown)
# BETTERSWAP_URL=https://www.betterswap.io/api
# BVM_URL=https://blackvemarket.com/api
# MAINNET_NODES=https://mainnet.vechain.org,https://mainnet.vecha.in

# requests per minute per visitor
# RATE_GATEWAY=240
# RATE_WRITES=30
